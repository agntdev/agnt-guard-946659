[
  {
    "name": "Spam with a link is warned",
    "steps": [
      {
        "send": {
          "update": {
            "update_id": 1,
            "message": {
              "message_id": 1,
              "date": 0,
              "chat": { "id": 300, "type": "supergroup", "title": "Test" },
              "from": { "id": 600, "is_bot": false, "first_name": "Spammy" },
              "text": "Check this out http://scam.example"
            }
          }
        },
        "expect": [
          {
            "method": "sendMessage",
            "payload": {
              "text": "⚠️ Spammy: that looked like spam (contains a link). Repeated spam leads to a mute, kick, or ban."
            }
          }
        ]
      }
    ]
  },
  {
    "name": "A current group administrator is never auto-moderated for a spam match",
    "strict": true,
    "steps": [
      {
        "send": {
          "update": {
            "update_id": 2,
            "message": {
              "message_id": 2,
              "date": 0,
              "chat": { "id": 301, "type": "supergroup", "title": "Test" },
              "from": { "id": 1, "is_bot": false, "first_name": "Administrator" },
              "text": "http://admin.example"
            }
          }
        },
        "expect": [{ "method": "getChatMember" }]
      }
    ]
  }
]
