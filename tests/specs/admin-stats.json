[
  {
    "name": "View Stats shows the empty-state summary",
    "steps": [
      {
        "send": { "text": "/mod", "chatId": 150, "userId": 1 },
        "expect": [
          {
            "method": "sendMessage",
            "payload": { "text": "Moderation panel. Pick an action, then choose a member to apply it to." }
          }
        ]
      },
      {
        "send": { "callback": "admin:stats", "chatId": 150, "userId": 1 },
        "expect": [
          {
            "method": "editMessageText",
            "payload": {
              "text": "📊 Moderation stats (last 200 actions)\n\nJoins: 0\nVerifications: 0\nWarns: 0\nMutes: 0\nKicks: 0\nBans: 0\nTrusted: 0\n\nNo moderation activity yet — actions will appear here."
            }
          }
        ]
      }
    ]
  },
  {
    "name": "Stats summary is delivered to the configured notification target",
    "steps": [
      {
        "send": { "text": "/mod", "chatId": 410, "userId": 1 },
        "expect": [
          {
            "method": "sendMessage",
            "payload": { "text": "Moderation panel. Pick an action, then choose a member to apply it to." }
          }
        ]
      },
      {
        "send": { "callback": "config:panel", "chatId": 410, "userId": 1 },
        "expect": [
          {
            "method": "editMessageText",
            "payload": { "text": "Settings. Tap what you'd like to change." }
          }
        ]
      },
      {
        "send": { "callback": "config:edit:notify", "chatId": 410, "userId": 1 },
        "expect": [
          {
            "method": "editMessageText",
            "payload": { "text": "Send the chat id that should receive summary reports (or /cancel)." }
          }
        ]
      },
      {
        "send": { "text": "4100", "chatId": 410, "userId": 1 },
        "expect": [
          {
            "method": "sendMessage",
            "payload": { "text": "✅ Saved. Summaries will go to chat 4100." }
          }
        ]
      },
      {
        "send": { "callback": "admin:stats", "chatId": 410, "userId": 1 },
        "expect": [{ "method": "editMessageText" }]
      },
      {
        "send": { "callback": "admin:stats:send", "chatId": 410, "userId": 1 },
        "expect": [
          {
            "method": "sendMessage",
            "payload": { "text": "Sent the summary to chat 4100." }
          }
        ]
      }
    ]
  }
]
