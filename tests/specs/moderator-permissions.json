[
  {
    "name": "A group administrator with restrict rights can manage moderators",
    "steps": [
      {
        "send": {
          "update": {
            "update_id": 901,
            "message": {
              "message_id": 901,
              "date": 0,
              "chat": { "id": 901, "type": "supergroup", "title": "Permissions" },
              "from": { "id": 1, "is_bot": false, "first_name": "Administrator" },
              "text": "/mod",
              "entities": [{ "type": "bot_command", "offset": 0, "length": 4 }]
            }
          }
        },
        "expect": [
          {
            "method": "sendMessage",
            "payload": { "text": "Moderation panel. Pick an action, then choose a member to apply it to." }
          }
        ]
      }
    ]
  },
  {
    "name": "A regular member is denied moderator management with next steps",
    "steps": [
      {
        "send": {
          "update": {
            "update_id": 902,
            "message": {
              "message_id": 902,
              "date": 0,
              "chat": { "id": 902, "type": "supergroup", "title": "Permissions" },
              "from": { "id": 2, "is_bot": false, "first_name": "Member" },
              "text": "/mod",
              "entities": [{ "type": "bot_command", "offset": 0, "length": 4 }]
            }
          }
        },
        "expect": [
          {
            "method": "sendMessage",
            "payload": { "text": "You must be the bot owner, a chat admin with Promote/Restrict rights, or a designated moderator to manage moderators. If you are an admin, ensure the bot is also an admin with Promote/Restrict rights." }
          }
        ]
      }
    ]
  }
]
