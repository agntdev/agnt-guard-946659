[
  {
    "name": "/mod opens the admin moderation panel",
    "steps": [
      {
        "send": { "text": "/mod", "chatId": 1, "userId": 1 },
        "expect": [
          {
            "method": "sendMessage",
            "payload": { "text": "Moderation panel. Pick an action, then choose a member to apply it to." }
          }
        ]
      }
    ]
  },
  {
    "name": "A legacy moderation-panel button acknowledges before rendering",
    "steps": [
      {
        "send": { "callback": "admin:commands-panel", "chatId": 2, "userId": 1 },
        "expect": [
          { "method": "answerCallbackQuery" },
          {
            "method": "editMessageText",
            "payload": { "text": "Moderation panel. Pick an action, then choose a member to apply it to." }
          }
        ]
      }
    ]
  },
  {
    "name": "A retried moderation callback is acknowledged without running the action twice",
    "strict": true,
    "steps": [
      {
        "send": {
          "update": {
            "update_id": 922,
            "callback_query": {
              "id": "retry-922",
              "from": { "id": 1, "is_bot": false, "first_name": "Admin" },
              "message": {
                "message_id": 922,
                "date": 0,
                "chat": { "id": 922, "type": "supergroup", "title": "Retries" },
                "from": { "id": 42, "is_bot": true, "first_name": "TestBot" },
                "text": "(previous)"
              },
              "chat_instance": "ci-922",
              "data": "admin:commands-panel"
            }
          }
        },
        "expect": [
          { "method": "answerCallbackQuery" },
          { "method": "getChatMember" },
          { "method": "getChatMember" },
          { "method": "editMessageText", "payload": { "text": "Moderation panel. Pick an action, then choose a member to apply it to." } }
        ]
      },
      {
        "send": {
          "update": {
            "update_id": 922,
            "callback_query": {
              "id": "retry-922",
              "from": { "id": 1, "is_bot": false, "first_name": "Admin" },
              "message": {
                "message_id": 922,
                "date": 0,
                "chat": { "id": 922, "type": "supergroup", "title": "Retries" },
                "from": { "id": 42, "is_bot": true, "first_name": "TestBot" },
                "text": "(previous)"
              },
              "chat_instance": "ci-922",
              "data": "admin:commands-panel"
            }
          }
        },
        "expect": [{ "method": "answerCallbackQuery" }]
      }
    ]
  }
]
